<Window x:Class="KabarakScriptRunnerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kabarak Script Runner"
        Language="en-US"
        Height="700" Width="1180"
        MinHeight="600" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0">
    <Window.Resources>
        <Style x:Key="RequiredLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="RequiredAsterisk" TargetType="Run">
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Text" Value=" *"/>
        </Style>
    </Window.Resources>
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="480"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: branding + current user -->
        <Border Grid.Column="0" BorderBrush="#A0A0A0" BorderThickness="1" Background="White" Margin="0,0,8,0">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" TextWrapping="Wrap" FontWeight="Bold" FontSize="13"
                           Text="Extract data from Kabarak University records and export to Excel"/>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">

                    <!-- Stacked papers with table icon -->
                    <Image Source="pack://application:,,,/Resources/icon-papers.png"
                           Width="64" Height="64"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center"/>

                    <!-- Down arrow -->
                    <Image Source="pack://application:,,,/Resources/icon-arrow.png"
                           Width="40" Height="40"
                           Margin="0,12"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center"/>

                    <!-- Document with text lines -->
                    <Image Source="pack://application:,,,/Resources/icon-document.png"
           Width="64" Height="64"
           Stretch="Uniform"
           RenderOptions.BitmapScalingMode="HighQuality"
           HorizontalAlignment="Center"/>

                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="Current user" HorizontalAlignment="Center" Margin="0,0,0,6"/>

                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="lblUserId"
                   Text="-"
                   HorizontalAlignment="Center"
                   FontWeight="Bold"/>
                        <TextBlock x:Name="lblUserName"
                   Text="-"
                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="lblDepartment"
                   Text="-"
                   HorizontalAlignment="Center"
                   FontStyle="Italic"
                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button x:Name="btnLogout"
                            Content="Logout"
                            Width="90" Height="28"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            Cursor="Hand"
                            ToolTip="Log out of the application"
                           Click="btnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CENTER: script list -->
        <Border Grid.Column="1" BorderBrush="#A0A0A0" BorderThickness="1" Background="White" Margin="0,0,8,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Available Scripts" FontWeight="Bold"
                           Margin="8,6,8,6" FontSize="13"/>

                <ListBox x:Name="lstScripts"
                         Grid.Row="1"
                         BorderThickness="0"
                         SelectionMode="Extended"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         HorizontalContentAlignment="Stretch"
                         SelectionChanged="lstScripts_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"
                                       FontWeight="SemiBold"
                                       Margin="2,2"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="ToolTip">
                                <Setter.Value>
                                    <ToolTip MaxWidth="380">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Category}" Foreground="#777" FontStyle="Italic" Margin="0,4,0,0"/>
                                            <TextBlock Foreground="#777" FontSize="11" Margin="0,4,0,0">
                                                <Run Text="Department: "/>
                                                <Run Text="{Binding DepartmentName}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </ToolTip>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <!-- RIGHT: filters, admin, progress, actions -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Filters -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Style="{StaticResource RequiredLabelStyle}"
                           ToolTip="This field is required.">
                           Output folder<Run Style="{StaticResource RequiredAsterisk}"/>
                </TextBlock>
                <TextBox x:Name="txtOutputFolder" Grid.Row="0" Grid.Column="1" Height="24" Margin="0,0,6,8"/>
                <Button x:Name="btnBrowseOutput" Grid.Row="0" Grid.Column="2"
                        Content="Browse…" Width="70" Height="24" Margin="0,0,0,8"
                        Click="btnBrowseOutput_Click"/>

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Style="{StaticResource RequiredLabelStyle}"
                           ToolTip="This field is required.">
                           Date from<Run Style="{StaticResource RequiredAsterisk}"/>
                </TextBlock>
                <DatePicker x:Name="dtpFrom" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                            Height="24" Margin="0,0,0,8"
                            SelectedDateFormat="Long"
                            DisplayDateStart="2000-01-01"
                            DisplayDateEnd="2100-12-31"/>

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Style="{StaticResource RequiredLabelStyle}"
                           ToolTip="This field is required.">
                           Date to<Run Style="{StaticResource RequiredAsterisk}"/>
                </TextBlock>
                <DatePicker x:Name="dtpTo" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                            Height="24"
                            SelectedDateFormat="Long"
                            DisplayDateStart="2000-01-01"
                            DisplayDateEnd="2100-12-31"/>
            </Grid>

            <!-- Admin group -->
            <GroupBox Grid.Row="1" Header="Admin" Margin="0,0,0,10" Padding="8">
                <WrapPanel>
                    <Button x:Name="btnScripts"   Content="Scripts"        Width="78"  Height="28" Margin="0,0,6,6" Click="btnScripts_Click"/>
                    <Button x:Name="btnUsers"     Content="Users"          Width="78"  Height="28" Margin="0,0,6,6" Click="btnUsers_Click"/>
                    <Button x:Name="btnAssign"    Content="Assign scripts" Width="110" Height="28" Margin="0,0,6,6" Click="btnAssign_Click"/>
                    <Button x:Name="btnOptions"   Content="Options"        Width="78"  Height="28" Margin="0,0,6,6" Click="btnOptions_Click"/>
                    <Button x:Name="btnAccessLog" Content="Access Log"     Width="90"  Height="28" Margin="0,0,0,6" Click="btnAccessLog_Click"/>
                </WrapPanel>
            </GroupBox>

            <!-- Progress group -->
            <GroupBox Grid.Row="2" Header="Progress" Margin="0,0,0,10">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- NEW: Selected script banner -->
                    <Border Grid.Row="0"
                            Background="#E8F4FD"
                            BorderBrush="#4FC3F7"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="8,6"
                            Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Selected script: "
                                       FontWeight="SemiBold"
                                       Foreground="#1565C0"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="lblSelectedScript"
                                       Text="(none)"
                                       Foreground="#0D47A1"
                                       FontStyle="Italic"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Progress bar + percentage -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ProgressBar x:Name="prgProgress"
                                     Grid.Column="0"
                                     Height="18"
                                     Minimum="0" Maximum="100" Value="0"
                                     Foreground="#4FC3F7"
                                     Background="#E0E0E0"
                                     BorderBrush="#B0B0B0"
                                     BorderThickness="1"/>

                        <TextBlock x:Name="lblProgressPercent"
                                   Grid.Column="1"
                                   Text=""
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   MinWidth="44"/>
                    </Grid>

                    <!-- Status line -->
                    <TextBlock x:Name="lblProgressStatus"
                   Grid.Row="2"
                   Text=""
                   Margin="0,6,0,4"
                   Foreground="#555"/>

                    <!-- Detailed log -->
                    <ListBox x:Name="lstProgressLog"
                 Grid.Row="3"
                 BorderThickness="1"
                 BorderBrush="#D0D0D0"
                 Background="White"
                 FontFamily="Consolas"
                 FontSize="11"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 SelectionMode="Single">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,1">
                                    <TextBlock Text="{Binding Timestamp}"
                                   Foreground="#888"
                                   Width="60"/>
                                    <TextBlock Text="{Binding Icon}"
                                   Width="20"
                                   FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Message}"
                                   TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </GroupBox>

            <!-- Bottom buttons -->
            <WrapPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                <Button x:Name="btnRefresh"    Content="Refresh scripts" Width="110" Height="32" Margin="0,0,6,6" Click="btnRefresh_Click"/>
                <Button x:Name="btnCancelRun"  Content="Cancel Run"      Width="100" Height="32" Margin="0,0,6,6" Click="btnCancelRun_Click" IsEnabled="False"/>
                <Button x:Name="btnRun"        Content="Run"             Width="70"  Height="32" Margin="0,0,6,6" Click="btnRun_Click"/>
                <Button x:Name="btnChangePassword" Content="Change Password" Width="120" Height="32" Margin="0,0,6,6" Click="btnChangePassword_Click"/>
                <Button x:Name="btnClose"      Content="Close"           Width="70"  Height="32" Margin="0,0,0,6" Click="btnClose_Click"/>
            </WrapPanel>
        </Grid>
    </Grid>
</Window>