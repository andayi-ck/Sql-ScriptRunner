<Window x:Class="KabarakScriptRunnerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kabarak Script Runner"
        Language="en-US"
        Height="600" Width="1000"
        MinHeight="520" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Page}"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="{StaticResource Brush.Text}"
        Icon="pack://application:,,,/Resources/app.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Icon -->
                <Image Source="pack://application:,,,/Resources/app.ico" Width="36" Height="36" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Kabarak Script Runner" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Extract university records and export to Excel" Style="{StaticResource MutedText}"/>
                </StackPanel>

                <!-- User Display with Avatar -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource Brush.PrimaryLight}" CornerRadius="20" Padding="6,6,16,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <!-- Avatar -->
                            <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource Brush.Primary}" Margin="0,0,10,0">
                                <TextBlock Text="👤" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <!-- User Details -->
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="lblUserId" FontWeight="SemiBold" Foreground="{StaticResource Brush.PrimaryDark}" FontSize="13"/>
                                <TextBlock>
                                    <Run x:Name="lblUserName" Foreground="{StaticResource Brush.Text}" FontSize="11"/>
                                    <Run Text=" · " Foreground="{StaticResource Brush.TextMuted}"/>
                                    <Run x:Name="lblDepartment" Foreground="{StaticResource Brush.TextMuted}" FontSize="11"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Button x:Name="btnLogout" Content="Logout" Style="{StaticResource GhostButton}" Height="32" Padding="14,0" Margin="0,0,8,0" Click="btnLogout_Click"/>
                    <Button x:Name="btnClose" Content="Exit" Style="{StaticResource GhostButton}" Height="32" Padding="14,0" Click="btnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ADMIN TOOLBAR -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="18,8">
            <DockPanel>
                <TextBlock Text="Admin" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextMuted}" FontWeight="SemiBold" Margin="0,0,14,0" Width="48"/>
                <Button x:Name="btnChangePassword" DockPanel.Dock="Right" Content="Change Password" Style="{StaticResource ToolbarButton}" Margin="0" Click="btnChangePassword_Click"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="btnBatchExport" Content="Batch Export" Style="{StaticResource ToolbarButton}" Click="btnBatchExport_Click"/>
                    <Button x:Name="btnDashboard"   Content="Dashboard"    Style="{StaticResource ToolbarButton}" Click="btnDashboard_Click"/>
                    <Button x:Name="btnScripts"     Content="Scripts"      Style="{StaticResource ToolbarButton}" Click="btnScripts_Click"/>
                    <Button x:Name="btnUsers"       Content="Users"        Style="{StaticResource ToolbarButton}" Click="btnUsers_Click"/>
                    <Button x:Name="btnAssign"      Content="Assign scripts" Style="{StaticResource ToolbarButton}" Click="btnAssign_Click"/>
                    <Button x:Name="btnOptions"     Content="Options"      Style="{StaticResource ToolbarButton}" Click="btnOptions_Click"/>
                    <Button x:Name="btnAccessLog"   Content="Access Log"   Style="{StaticResource ToolbarButton}" Click="btnAccessLog_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- BODY -->
        <Grid Grid.Row="2" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <!-- Increased Left Panel -->
                <ColumnDefinition Width="*"/>
                <!-- Reduced Middle Panel -->
                <ColumnDefinition Width="400"/>
                <!-- Right Panel -->
            </Grid.ColumnDefinitions>

            <!-- LEFT: Categories & Branding Graphic -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,10,0" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Title -->
                        <RowDefinition Height="*"/>
                        <!-- Categories List -->
                        <RowDefinition Height="Auto"/>
                        <!-- The Restored Graphic -->
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Categories" Style="{StaticResource SectionTitle}" Margin="4,2,4,10"/>

                    <ListBox x:Name="lstCategories" Grid.Row="1" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="lstCategories_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Count}" Foreground="{StaticResource Brush.TextMuted}" FontSize="11"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="8,2"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <Grid>
                                                    <Border x:Name="Accent" Width="3" HorizontalAlignment="Left" Background="Transparent" CornerRadius="2" Margin="-8,2,0,2"/>
                                                    <ContentPresenter Margin="6,0,0,0"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.PrimaryLight}"/>
                                                    <Setter TargetName="Accent" Property="Background" Value="{StaticResource Brush.Primary}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- RESTORED: The Graphic/Logo -->
                    <StackPanel Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,20,0,10">
                        <Image Source="pack://application:,,,/Resources/icon-papers.png"
                               Width="64" Height="64" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center"/>
                        <Image Source="pack://application:,,,/Resources/icon-arrow.png"
                               Width="40" Height="40" Margin="0,12" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center"/>
                        <Image Source="pack://application:,,,/Resources/icon-document.png"
                               Width="64" Height="64" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CENTER: Scripts -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="0,0,10,0" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="16,14,16,8">
                        <TextBlock Text="Available Scripts" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblScriptCount" Style="{StaticResource MutedText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="16,0,16,10">
                        <TextBox x:Name="txtScriptSearch" Height="34" Padding="10,4" TextChanged="txtScriptSearch_TextChanged"/>
                        <TextBlock x:Name="lblScriptSearchHint" Text="Search scripts by name, category, or department..." Foreground="#9AA3B2" FontStyle="Italic" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>

                    <Grid Grid.Row="2">
                        <ListBox x:Name="lstScripts" BorderThickness="0" SelectionMode="Extended" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" SelectionChanged="lstScripts_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="8,6">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Foreground="{StaticResource Brush.TextMuted}" FontSize="11" Margin="0,2,0,0">
                                            <Run Text="{Binding Category, Mode=OneWay}"/>
                                            <Run Text="  ·  "/>
                                            <Run Text="{Binding DepartmentName, Mode=OneWay}"/>
                                            <Run Text="   v"/>
                                            <Run Text="{Binding Version, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="4,0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="ToolTip">
                                        <Setter.Value>
                                            <ToolTip MaxWidth="420">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                                    <TextBlock Foreground="#777" FontStyle="Italic" Margin="0,6,0,0">
                                                        <Run Text="{Binding Category, Mode=OneWay}"/>
                                                        <Run Text=" · Department: "/>
                                                        <Run Text="{Binding DepartmentName, Mode=OneWay}"/>
                                                        <Run Text=" · v"/>
                                                        <Run Text="{Binding Version, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </ToolTip>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Brush.PrimaryLight}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <Border x:Name="LoadingOverlay" Background="#D8FFFFFF" Visibility="Collapsed" Panel.ZIndex="10">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="Checking for updates..." FontWeight="SemiBold" Foreground="{StaticResource Brush.Primary}" FontSize="14" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- RIGHT: Run Setup -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Run setup" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" ToolTip="This field is required.">
                            Output folder<Run Style="{StaticResource RequiredAsterisk}"/>
                        </TextBlock>
                        <TextBox x:Name="txtOutputFolder" Grid.Row="0" Grid.Column="1" Margin="0,0,8,10"/>
                        <Button x:Name="btnBrowseOutput" Grid.Row="0" Grid.Column="2" Content="Browse…" Height="32" Padding="12,0" Margin="0,0,0,10" Click="btnBrowseOutput_Click"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" ToolTip="This field is required.">
                            Date from<Run Style="{StaticResource RequiredAsterisk}"/>
                        </TextBlock>
                        <DatePicker x:Name="dtpFrom" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10" SelectedDateFormat="Long" DisplayDateStart="2000-01-01" DisplayDateEnd="2100-12-31"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" ToolTip="This field is required.">
                            Date to<Run Style="{StaticResource RequiredAsterisk}"/>
                        </TextBlock>
                        <DatePicker x:Name="dtpTo" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" SelectedDateFormat="Long" DisplayDateStart="2000-01-01" DisplayDateEnd="2100-12-31"/>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Background="{StaticResource Brush.PrimaryLight}" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Selected script: " FontWeight="SemiBold" Foreground="{StaticResource Brush.PrimaryDark}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblSelectedScript" Text="(none)" Foreground="{StaticResource Brush.Primary}" FontStyle="Italic" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="1" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ProgressBar x:Name="prgProgress" Grid.Column="0" Minimum="0" Maximum="100" Value="0"/>
                            <TextBlock x:Name="lblProgressPercent" Grid.Column="1" Text="" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" MinWidth="40" Foreground="{StaticResource Brush.Primary}"/>
                        </Grid>

                        <TextBlock x:Name="lblProgressStatus" Grid.Row="2" Text="" Margin="0,0,0,8" Foreground="{StaticResource Brush.TextMuted}"/>

                        <ListBox x:Name="lstProgressLog" Grid.Row="3" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Background="White" FontFamily="Consolas" FontSize="11" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionMode="Single">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="6,2">
                                        <TextBlock Text="{Binding Timestamp}" Foreground="#8A94A6" Width="64"/>
                                        <TextBlock Text="{Binding Icon}" Width="18" FontWeight="Bold" Foreground="{StaticResource Brush.Primary}"/>
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="btnRefresh" Content="Refresh scripts" Height="36" HorizontalAlignment="Left" Padding="14,0" Click="btnRefresh_Click"/>
                        <Button x:Name="btnCancelRun" Grid.Column="1" Content="Cancel Run" Style="{StaticResource DangerButton}" Height="36" Width="110" Margin="0,0,8,0" Click="btnCancelRun_Click" IsEnabled="False"/>
                        <Button x:Name="btnRun" Grid.Column="2" Content="Run" Style="{StaticResource PrimaryButton}" Height="36" Width="110" Click="btnRun_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>