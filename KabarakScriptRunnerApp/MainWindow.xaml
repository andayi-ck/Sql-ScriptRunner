<Window x:Class="KabarakScriptRunnerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:notification="clr-namespace:Notification.Wpf.Controls;assembly=Notification.Wpf"
        Title="Kabarak Script Runner"
        Language="en-US"
        Height="700" Width="1180"
        MinHeight="600" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0">
    <Window.Resources>
        <Style x:Key="RequiredLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="RequiredAsterisk" TargetType="Run">
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Text" Value=" *"/>
        </Style>
        <!-- NEW: AI Mode Button Style -->
        <Style x:Key="AiModeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F0F4F9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="20" 
                                BorderBrush="Transparent" 
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover effect: subtle shadow and border highlight -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#D2E3FC"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#1565C0" BlurRadius="10" ShadowDepth="0" Opacity="0.3"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="480"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: branding + current user -->
        <Border Grid.Column="0" BorderBrush="#A0A0A0" BorderThickness="1" Background="White" Margin="0,0,8,0">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" TextWrapping="Wrap" FontWeight="Bold" FontSize="13"
                           Text="Extract data from Kabarak University records and export to Excel"/>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image Source="pack://application:,,,/Resources/icon-papers.png"
                           Width="64" Height="64"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center"/>
                    <Image Source="pack://application:,,,/Resources/icon-arrow.png"
                           Width="40" Height="40"
                           Margin="0,12"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center"/>
                    <Image Source="pack://application:,,,/Resources/icon-document.png"
                           Width="64" Height="64"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="Current user" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="lblUserId" Text="-" HorizontalAlignment="Center" FontWeight="Bold"/>
                        <TextBlock x:Name="lblUserName" Text="-" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="lblDepartment" Text="-" HorizontalAlignment="Center" FontStyle="Italic" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button x:Name="btnLogout" Content="Logout" Width="90" Height="28" Margin="0,10,0,0"
                            HorizontalAlignment="Center" Cursor="Hand" ToolTip="Log out of the application" Click="btnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CENTER: search + script list -->
        <Border Grid.Column="1" BorderBrush="#A0A0A0" BorderThickness="1" Background="White" Margin="0,0,8,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="8,6,8,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Available Scripts" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>

                    <!-- The New AI Mode Button -->
                    <Button x:Name="btnAskAi" Grid.Column="1" 
                                Style="{StaticResource AiModeButtonStyle}" 
                                Click="btnAskAi_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✨" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="AI Mode" FontWeight="SemiBold" Foreground="#1F1F1F" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Search box + count -->
                <Grid Grid.Row="1" Margin="8,0,8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtScriptSearch" Grid.Column="0" Height="28" Padding="6,3" VerticalContentAlignment="Center" TextChanged="txtScriptSearch_TextChanged"/>
                    <TextBlock x:Name="lblScriptSearchHint" Grid.Column="0" Text="🔍  Search scripts by name, category, or department..."
                               Foreground="#999" FontStyle="Italic" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Panel.ZIndex="1"/>
                    <TextBlock x:Name="lblScriptCount" Grid.Column="1" Foreground="#666" FontStyle="Italic" VerticalAlignment="Center" Margin="10,0,0,0" Text=""/>
                </Grid>

                <!-- The ListBox with the Loading Overlay -->
                <Grid Grid.Row="2">
                    <ListBox x:Name="lstScripts"
                             BorderThickness="0"
                             SelectionMode="Extended"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             HorizontalContentAlignment="Stretch"
                             SelectionChanged="lstScripts_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,2">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Foreground="#999" FontSize="10">
                                        <Run Text="{Binding Category}"/>
                                        <Run Text=" • "/>
                                        <Run Text="{Binding DepartmentName}"/>
                                        <Run Text="  (v"/>
                                        <Run Text="{Binding Version}"/>
                                        <Run Text=")"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="ToolTip">
                                    <Setter.Value>
                                        <ToolTip MaxWidth="420">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                                <TextBlock Foreground="#777" FontStyle="Italic" Margin="0,6,0,0">
                                                    <Run Text="{Binding Category}"/>
                                                    <Run Text=" • Department: "/>
                                                    <Run Text="{Binding DepartmentName}"/>
                                                    <Run Text=" • v"/>
                                                    <Run Text="{Binding Version}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </ToolTip>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- NEW: Loading Overlay -->
                    <Border x:Name="LoadingOverlay" 
                            Background="#D0FFFFFF" 
                            Visibility="Collapsed" 
                            Panel.ZIndex="10">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="⏳" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Checking for updates..." 
                                       FontWeight="SemiBold" 
                                       Foreground="#1565C0" 
                                       FontSize="14" 
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- RIGHT: filters, admin, progress, actions -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Filters -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource RequiredLabelStyle}" ToolTip="This field is required.">
                           Output folder<Run Style="{StaticResource RequiredAsterisk}"/>
                </TextBlock>
                <TextBox x:Name="txtOutputFolder" Grid.Row="0" Grid.Column="1" Height="24" Margin="0,0,6,8"/>
                <Button x:Name="btnBrowseOutput" Grid.Row="0" Grid.Column="2" Content="Browse…" Width="70" Height="24" Margin="0,0,0,8" Click="btnBrowseOutput_Click"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource RequiredLabelStyle}" ToolTip="This field is required.">
                           Date from<Run Style="{StaticResource RequiredAsterisk}"/>
                </TextBlock>
                <DatePicker x:Name="dtpFrom" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Height="24" Margin="0,0,0,8" SelectedDateFormat="Long" DisplayDateStart="2000-01-01" DisplayDateEnd="2100-12-31"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource RequiredLabelStyle}" ToolTip="This field is required.">
                           Date to<Run Style="{StaticResource RequiredAsterisk}"/>
                </TextBlock>
                <DatePicker x:Name="dtpTo" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Height="24" SelectedDateFormat="Long" DisplayDateStart="2000-01-01" DisplayDateEnd="2100-12-31"/>
            </Grid>

            <!-- Admin group -->
            <GroupBox Grid.Row="1" Header="Admin" Margin="0,0,0,10" Padding="8">
                <WrapPanel>
                    
                    <Button x:Name="btnBatchExport" Content="Batch Export" Width="110" Height="28" Margin="0,0,6,6" Click="btnBatchExport_Click"/>
                    <Button x:Name="btnDashboard"   Content="Dashboard"    Width="90"  Height="28" Margin="0,0,6,6" Click="btnDashboard_Click"/>
                    <Button x:Name="btnScripts"     Content="Scripts"      Width="78"  Height="28" Margin="0,0,6,6" Click="btnScripts_Click"/>
                    <Button x:Name="btnUsers"       Content="Users"        Width="78"  Height="28" Margin="0,0,6,6" Click="btnUsers_Click"/>
                    <Button x:Name="btnAssign"      Content="Assign scripts" Width="110" Height="28" Margin="0,0,6,6" Click="btnAssign_Click"/>
                    <Button x:Name="btnOptions"     Content="Options"      Width="78"  Height="28" Margin="0,0,6,6" Click="btnOptions_Click"/>
                    <Button x:Name="btnAccessLog"   Content="Access Log"   Width="90"  Height="28" Margin="0,0,0,6" Click="btnAccessLog_Click"/>
                </WrapPanel>
            </GroupBox>

            <!-- Progress group -->
            <GroupBox Grid.Row="2" Header="Progress" Margin="0,0,0,10">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#E8F4FD" BorderBrush="#4FC3F7" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Selected script: " FontWeight="SemiBold" Foreground="#1565C0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="lblSelectedScript" Text="(none)" Foreground="#0D47A1" FontStyle="Italic" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="prgProgress" Grid.Column="0" Height="18" Minimum="0" Maximum="100" Value="0" Foreground="#4FC3F7" Background="#E0E0E0" BorderBrush="#B0B0B0" BorderThickness="1"/>
                        <TextBlock x:Name="lblProgressPercent" Grid.Column="1" Text="" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="Bold" MinWidth="44"/>
                    </Grid>

                    <TextBlock x:Name="lblProgressStatus" Grid.Row="2" Text="" Margin="0,6,0,4" Foreground="#555"/>

                    <ListBox x:Name="lstProgressLog" Grid.Row="3" BorderThickness="1" BorderBrush="#D0D0D0" Background="White" FontFamily="Consolas" FontSize="11" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionMode="Single">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,1">
                                    <TextBlock Text="{Binding Timestamp}" Foreground="#888" Width="60"/>
                                    <TextBlock Text="{Binding Icon}" Width="20" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </GroupBox>

            <!-- Bottom buttons -->
            <WrapPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                <Button x:Name="btnRefresh"    Content="Refresh scripts" Width="110" Height="32" Margin="0,0,6,6" Click="btnRefresh_Click"/>
                <Button x:Name="btnCancelRun"  Content="Cancel Run"      Width="100" Height="32" Margin="0,0,6,6" Click="btnCancelRun_Click" IsEnabled="False"/>
                <Button x:Name="btnRun"        Content="Run"             Width="70"  Height="32" Margin="0,0,6,6" Click="btnRun_Click"/>
                <Button x:Name="btnChangePassword" Content="Change Password" Width="120" Height="32" Margin="0,0,6,6" Click="btnChangePassword_Click"/>
                <Button x:Name="btnClose"      Content="Close"           Width="70"  Height="32" Margin="0,0,0,6" Click="btnClose_Click"/>
            </WrapPanel>
        </Grid>
    </Grid>
</Window>