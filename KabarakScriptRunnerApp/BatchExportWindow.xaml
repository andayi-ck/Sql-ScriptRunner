<Window x:Class="KabarakScriptRunnerApp.BatchExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batch Export"
        Height="720" Width="1000"
        WindowStartupLocation="CenterOwner"
        Background="#F0F0F0">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Batch Export" FontSize="20" FontWeight="Bold" Foreground="#1565C0"/>
            <TextBlock Text="Select multiple scripts, choose a date range, and export all results to Excel at once."
                       Foreground="#666" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Filter row -->
        <Border Grid.Row="1" Background="#F7F7F7" BorderBrush="#D0D0D0" BorderThickness="1"
                CornerRadius="3" Padding="10,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Filter:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="txtFilter" Grid.Column="1" Height="26" Margin="0,0,12,0"
                         TextChanged="txtFilter_TextChanged"/>

                <TextBlock Grid.Column="2" Text="From:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <DatePicker x:Name="dtpFrom" Grid.Column="3" Width="140" Height="26" Margin="0,0,12,0"
                            SelectedDateFormat="Short"/>

                <TextBlock Grid.Column="4" Text="To:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <DatePicker x:Name="dtpTo" Grid.Column="5" Width="140" Height="26" Margin="0,0,12,0"
                            SelectedDateFormat="Short"/>

                <Button x:Name="btnSelectAll" Grid.Column="6" Content="Select All"
                        Width="90" Height="26" Click="btnSelectAll_Click"/>
            </Grid>
        </Border>

        <!-- Script list with checkboxes -->
        <Border Grid.Row="2" Background="White" BorderBrush="#A0A0A0" BorderThickness="1">
            <DataGrid x:Name="dgScripts"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="26"
                      Background="White"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Select" Binding="{Binding IsSelected, Mode=TwoWay}" Width="60"/>
                    <DataGridTextColumn Header="Script Name" Binding="{Binding Name}" Width="280" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Department" Binding="{Binding DepartmentName}" Width="140" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="70" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Output folder + options -->
        <Border Grid.Row="3" Background="#F7F7F7" BorderBrush="#D0D0D0" BorderThickness="1"
                CornerRadius="3" Padding="10,8" Margin="0,10,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Output Folder:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="txtOutputFolder" Grid.Row="0" Grid.Column="1" Height="26" Margin="0,0,8,8"/>
                <Button x:Name="btnBrowse" Grid.Row="0" Grid.Column="2"
                        Content="Browse…" Width="90" Height="26" Margin="0,0,0,8" Click="btnBrowse_Click"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Run At (optional):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker x:Name="dtpScheduleDate" Grid.Row="1" Grid.Column="1"
                            HorizontalAlignment="Left" Width="160" Height="26" Margin="0,0,8,0"
                            SelectedDateFormat="Short"/>
                <TextBox x:Name="txtScheduleTime" Grid.Row="1" Grid.Column="2"
                         Width="80" Height="26" Text="02:00" Margin="0,0,8,0"/>
                <TextBlock Grid.Row="1" Grid.Column="3" VerticalAlignment="Center"
                           Foreground="#777" FontSize="11" Margin="0,0,8,0"
                           Text="(HH:mm). Leave blank to run now."/>

            </Grid>
        </Border>

        <!-- Status + progress -->
        <StackPanel Grid.Row="4">
            <ProgressBar x:Name="prgBatch" Height="18" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,6"/>
            <TextBlock x:Name="lblStatus" Foreground="#555"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="btnRunBatch" Content="Run Batch"
                        Width="120" Height="34" Margin="0,0,8,0"
                        Background="#1565C0" Foreground="White" FontWeight="Bold"
                        Click="btnRunBatch_Click"/>
                <Button x:Name="btnCancel" Content="Cancel"
                        Width="90" Height="34" Margin="0,0,8,0" Click="btnCancel_Click"/>
                <Button x:Name="btnClose" Content="Close"
                        Width="90" Height="34" Click="btnClose_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>