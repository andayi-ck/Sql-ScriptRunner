<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>KabarakScriptRunnerApp</RootNamespace>
    <AssemblyName>KabarakScriptRunnerApp</AssemblyName>
    <Version>2.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Product>Script Runner</Product>
    <Company>Kabarak University</Company>
    <Copyright>Copyright © Kabarak University 2026</Copyright>
    <Description>Desktop application for extracting Kabarak University data to Excel</Description>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- =========================================================== -->
    <!--  FRAMEWORK-DEPENDENT PUBLISH (Option C)                     -->
    <!--  Smaller installer, folder-based output, .NET installed by  -->
    <!--  InnoDependencyInstaller if missing on the target machine.  -->
    <!-- =========================================================== -->
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>

    <!-- =========================================================== -->
    <!--  SENTRY DEBUG SYMBOL UPLOADING (Optional but recommended)   -->
    <!-- =========================================================== -->
    <!-- These properties tell Sentry to upload .pdb files during    -->
    <!-- a Release build so you get exact line numbers in errors.    -->
    <SentryOrg>YOUR_SENTRY_ORG_SLUG</SentryOrg>
    <SentryProject>YOUR_SENTRY_PROJECT_SLUG</SentryProject>
    <SentryUploadSymbols>true</SentryUploadSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove=".github\**" />
    <EmbeddedResource Remove=".github\**" />
    <None Remove=".github\**" />
    <Page Remove=".github\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\app.ico" />
    <None Remove="Resources\icon-arrow.png" />
    <None Remove="Resources\icon-document.png" />
    <None Remove="Resources\icon-papers.png" />
    <None Remove="Resources\splash.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="FluentValidation" Version="12.2.0" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Notification.Wpf" Version="11.0.0" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <!-- Sentry SDK -->
    <PackageReference Include="Sentry" Version="6.12.1" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="ToastNotifications" Version="2.5.1" />
    <PackageReference Include="ToastNotifications.Messages" Version="2.5.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KabarakScriptRunner.Core\KabarakScriptRunner.Core.csproj" />
    <ProjectReference Include="..\KabarakScriptRunner.Data\KabarakScriptRunner.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\icon-arrow.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\icon-document.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\icon-papers.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <SplashScreen Include="Resources\splash.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </SplashScreen>
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>