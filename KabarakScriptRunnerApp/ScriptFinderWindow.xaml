<Window x:Class="KabarakScriptRunnerApp.ScriptFinderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find a Script"
        Height="540" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="#F0F0F0">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Search box -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="txtSearch"
                     Grid.Column="0"
                     Height="30"
                     FontSize="13"
                     Padding="6,3"
                     VerticalContentAlignment="Center"
                     TextChanged="txtSearch_TextChanged"/>

            <TextBlock x:Name="lblSearchHint"
                       Grid.Column="0"
                       Text="Type script name, description, or department..."
                       Foreground="#999"
                       FontStyle="Italic"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Panel.ZIndex="1"/>
        </Grid>

        <!-- Row 1: Department filter -->
        <Border Grid.Row="1"
                Background="#F7F7F7"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                CornerRadius="3"
                Padding="10,8"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <CheckBox x:Name="chkFilterByDept"
                          Grid.Column="0"
                          Content="Filter By Department"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0"
                          Checked="chkFilterByDept_Changed"
                          Unchecked="chkFilterByDept_Changed"/>

                <ComboBox x:Name="cmbDepartment"
                          Grid.Column="1"
                          Height="26"
                          IsEnabled="False"
                          DisplayMemberPath="DepartmentName"
                          SelectedValuePath="DepartmentId"
                          SelectionChanged="cmbDepartment_SelectionChanged"/>

                <TextBlock x:Name="lblResultsCount"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           Foreground="#555"
                           Margin="12,0,0,0"
                           FontStyle="Italic"/>
            </Grid>
        </Border>

        <!-- Row 2: Results -->
        <ListBox x:Name="lstResults"
                 Grid.Row="2"
                 BorderBrush="#A0A0A0"
                 BorderThickness="1"
                 Background="White"
                 MouseDoubleClick="lstResults_MouseDoubleClick"
                 KeyDown="lstResults_KeyDown">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4,4">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Description}"
                                   Foreground="#666"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                        <TextBlock FontSize="10" Foreground="#999" Margin="0,2,0,0">
                            <Run Text="Category: "/>
                            <Run Text="{Binding Category}"/>
                            <Run Text="  •  Department: "/>
                            <Run Text="{Binding DepartmentName}"/>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Row 3: Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnSelect" Content="Select"
                    Width="90" Height="32" Margin="0,0,8,0"
                    IsDefault="True"
                    Click="btnSelect_Click"/>
            <Button x:Name="btnCancel" Content="Cancel"
                    Width="90" Height="32"
                    IsCancel="True"
                    Click="btnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>