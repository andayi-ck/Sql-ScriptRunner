<Window x:Class="KabarakScriptRunnerApp.AiChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ask AI" Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border Background="White" CornerRadius="12" BorderBrush="#D0D0D0" BorderThickness="1" Margin="20">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.2" BlurRadius="20" ShadowDepth="5"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#F8F9FA" CornerRadius="12,12,0,0" Padding="15">
                <Grid>
                    <TextBlock Text="✨ Ask AI about your data" FontSize="18" FontWeight="Bold" Foreground="#1565C0"/>
                    <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" FontSize="16" Click="Close_Click"/>
                </Grid>
            </Border>

            <!-- Chat History (ListBox with DataTemplate for bubbles) -->
            <ListBox x:Name="ChatHistory" Grid.Row="1" BorderThickness="0" Background="#FFFFFF" Margin="10" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- Input Area -->
            <Border Grid.Row="2" Background="#F8F9FA" CornerRadius="0,0,12,12" Padding="15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="UserInput" Grid.Column="0" Height="40" Padding="10" FontSize="14" KeyDown="UserInput_KeyDown"/>
                    <Button x:Name="SendButton" Grid.Column="1" Content="Send" Width="80" Height="40" Margin="10,0,0,0" Click="Send_Click" Background="#1565C0" Foreground="White" FontWeight="Bold"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>