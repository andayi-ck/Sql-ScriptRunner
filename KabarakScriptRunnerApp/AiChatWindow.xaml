<Window x:Class="KabarakScriptRunnerApp.AiChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Mode" Height="700" Width="800"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <!-- Outer border for shadow effect -->
    <Border Background="#FFFFFF" CornerRadius="24" Margin="20">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="30" ShadowDepth="10"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="*"/>
                <!-- Chat Area -->
                <RowDefinition Height="Auto"/>
                <!-- Input Area -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="24,16,24,16">
                <TextBlock Text="✨ AI Mode" FontSize="18" FontWeight="Bold" Foreground="#1F1F1F"/>
                <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" FontSize="16" Click="Close_Click" Cursor="Hand"/>
            </Grid>

            <!-- Chat History -->
            <ScrollViewer Grid.Row="1" x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto" Margin="24,0,24,0">
                <StackPanel x:Name="ChatMessagesPanel"/>
            </ScrollViewer>

            <!-- Input Area (Google Style) -->
            <Border Grid.Row="2" Margin="24,16,24,24" Background="#F0F4F9" CornerRadius="24" Padding="16,12" BorderBrush="#D2E3FC" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="UserInput" Grid.Column="0" 
                             Background="Transparent" BorderThickness="0" 
                             FontSize="14" VerticalContentAlignment="Center"
                             KeyDown="UserInput_KeyDown" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="100"/>

                    <Button x:Name="SendButton" Grid.Column="1" Content="➤" 
                            Width="32" Height="32" Margin="8,0,0,0" 
                            Background="#1565C0" Foreground="White" 
                            FontSize="14" FontWeight="Bold" BorderThickness="0"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Click="Send_Click" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="16"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>