<Window x:Class="KabarakScriptRunnerApp.UsersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User Management"
        Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#F0F0F0">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Application Users"
                   FontSize="16" FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <!-- Data grid -->
        <DataGrid x:Name="dgUsers"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="White"
                  RowHeight="26"
                  BorderBrush="#A0A0A0" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="User ID"        Binding="{Binding UserId}"           Width="130"/>
                <DataGridTextColumn Header="Display Name"   Binding="{Binding DisplayName}"      Width="200"/>
                <DataGridTextColumn Header="Department"     Binding="{Binding DepartmentName}"   Width="160"/>
                <DataGridCheckBoxColumn Header="Admin"      Binding="{Binding IsAdmin}"          Width="60"/>
                <DataGridCheckBoxColumn Header="Active"     Binding="{Binding IsActive}"         Width="60"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnNew"      Content="New User"     Width="100" Height="32" Margin="0,0,6,0" Click="btnNew_Click"/>
            <Button x:Name="btnEdit"     Content="Edit User"    Width="100" Height="32" Margin="0,0,6,0" Click="btnEdit_Click"/>
            <Button x:Name="btnToggle"   Content="Activate / Deactivate" Width="160" Height="32" Margin="0,0,6,0" Click="btnToggle_Click"/>
            <Button x:Name="btnRefresh"  Content="Refresh"      Width="90"  Height="32" Margin="0,0,6,0" Click="btnRefresh_Click"/>
            <Button x:Name="btnClose"    Content="Close"        Width="90"  Height="32" Click="btnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>