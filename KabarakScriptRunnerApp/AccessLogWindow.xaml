<Window x:Class="KabarakScriptRunnerApp.AccessLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="Access Log"
        Height="680" Width="1200"
        WindowStartupLocation="CenterOwner"
        Background="#F0F0F0">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Shared filter row -->
        <Border Grid.Row="0" Background="#F7F7F7" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- From -->
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- To -->
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- User -->
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Status -->
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <!-- Spacer -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Buttons -->
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="From:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <DatePicker x:Name="dtpFrom" Grid.Column="1" Width="120" Height="26" Margin="0,0,12,0"/>

                <TextBlock Grid.Column="2" Text="To:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <DatePicker x:Name="dtpTo" Grid.Column="3" Width="120" Height="26" Margin="0,0,12,0"/>

                <TextBlock Grid.Column="4" Text="User:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="cmbUser" Grid.Column="5" Width="140" Height="26" Margin="0,0,12,0"
                          DisplayMemberPath="DisplayName" SelectedValuePath="UserId"/>

                <TextBlock Grid.Column="6" Text="Status:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="cmbStatus" Grid.Column="7" Width="100" Height="26" Margin="0,0,12,0">
                    <ComboBoxItem Content="(All)" IsSelected="True"/>
                    <ComboBoxItem Content="Success"/>
                    <ComboBoxItem Content="Failed"/>
                    <ComboBoxItem Content="Running"/>
                </ComboBox>

                <StackPanel Grid.Column="9" Orientation="Horizontal">
                    <Button x:Name="btnApply" Content="Apply Filter" Width="100" Height="26" Margin="0,0,6,0" Click="btnApply_Click"/>
                    <Button x:Name="btnClear" Content="Clear" Width="70" Height="26" Click="btnClear_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tabs -->
        <TabControl Grid.Row="1" x:Name="tabLogs" SelectionChanged="tabLogs_SelectionChanged">

            <!-- TAB 1: SCRIPT RUNS -->
            <TabItem Header="Script Runs">
                <Grid>
                    <DataGrid x:Name="dgLogs" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              Background="White" RowHeight="24" BorderBrush="#A0A0A0" BorderThickness="1"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Run ID"   Binding="{Binding RunId}"     Width="70"/>
                            <DataGridTextColumn Header="Started"  Binding="{Binding StartedAt, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="150"/>
                            <DataGridTextColumn Header="Finished" Binding="{Binding FinishedAt, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="150"/>
                            <DataGridTextColumn Header="User"     Binding="{Binding UserId}"    Width="90"/>
                            <DataGridTextColumn Header="Name"     Binding="{Binding DisplayName}" Width="140"/>
                            <DataGridTextColumn Header="Script"   Binding="{Binding ScriptName}"  Width="240"/>
                            <DataGridTextColumn Header="Status"   Binding="{Binding Status}"      Width="80"/>
                            <DataGridTextColumn Header="Rows"     Binding="{Binding RowsAffected}" Width="70"/>
                            <DataGridTextColumn Header="Error"    Binding="{Binding ErrorMessage}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 2: ADMIN ACTIONS -->
            <TabItem Header="Admin Actions">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="8,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Filter by action:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="cmbActionType" Width="180" Height="24" SelectionChanged="cmbActionType_SelectionChanged">
                                <ComboBoxItem Content="(All)" IsSelected="True"/>
                                <ComboBoxItem Content="LoginSuccess"/>
                                <ComboBoxItem Content="LoginFailure"/>
                                <ComboBoxItem Content="Logout"/>
                                <ComboBoxItem Content="ScriptViewed"/>
                                <ComboBoxItem Content="ScriptRan"/>
                                <ComboBoxItem Content="UserCreated"/>
                                <ComboBoxItem Content="UserUpdated"/>
                                <ComboBoxItem Content="UserActivated"/>
                                <ComboBoxItem Content="UserDeactivated"/>
                                <ComboBoxItem Content="PasswordChanged"/>
                                <ComboBoxItem Content="ScriptReassigned"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="dgActions" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              Background="White" RowHeight="24" BorderBrush="#A0A0A0" BorderThickness="1"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"        Binding="{Binding ActionId}"     Width="60"/>
                            <DataGridTextColumn Header="When"      Binding="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="150"/>
                            <DataGridTextColumn Header="Admin"     Binding="{Binding UserId}"       Width="90"/>
                            <DataGridTextColumn Header="Action"    Binding="{Binding ActionType}"   Width="150"/>
                            <DataGridTextColumn Header="Target"    Binding="{Binding TargetType}"   Width="80"/>
                            <DataGridTextColumn Header="Target ID" Binding="{Binding TargetId}"     Width="90"/>
                            <DataGridTextColumn Header="Details"   Binding="{Binding Details}"      Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 3: ANALYTICS -->
            <TabItem Header="Analytics">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Login activity chart -->
                    <Border Grid.Row="0" Grid.Column="0" Background="White" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Margin="4" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Logins Per Day (Last 30 days) — Line Chart" FontWeight="Bold" Margin="0,0,0,8"/>
                            <lvc:CartesianChart Grid.Row="1" x:Name="chartLogins"/>
                        </Grid>
                    </Border>

                    <!-- Login success vs failure -->
                    <Border Grid.Row="0" Grid.Column="1" Background="White" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Margin="4" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Login Success vs Failure (Last 30 days) — Pie Chart" FontWeight="Bold" Margin="0,0,0,8"/>
                            <lvc:PieChart Grid.Row="1" x:Name="chartLoginPie"/>
                        </Grid>
                    </Border>

                    <!-- Top scripts -->
                    <Border Grid.Row="1" Grid.Column="0" Background="White" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Margin="4" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Top Scripts by Run Count — Bar Chart" FontWeight="Bold" Margin="0,0,0,8"/>
                            <lvc:CartesianChart Grid.Row="1" x:Name="chartTopScripts"/>
                        </Grid>
                    </Border>

                    <!-- Actions by user -->
                    <Border Grid.Row="1" Grid.Column="1" Background="White" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Margin="4" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Actions by User (Last 30 days) — Bar Chart" FontWeight="Bold" Margin="0,0,0,8"/>
                            <lvc:CartesianChart Grid.Row="1" x:Name="chartActionsByUser"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Bottom buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="lblRowCount" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#555"/>
            <Button x:Name="btnExportPdf" Content="Export Current Tab to PDF" Width="200" Height="32" Margin="0,0,8,0" Click="btnExportPdf_Click"/>
            <Button x:Name="btnClose" Content="Close" Width="90" Height="32" Click="btnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>