<Window x:Class="KabarakScriptRunnerApp.AccessLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Access Log"
        Height="640" Width="1150"
        WindowStartupLocation="CenterOwner"
        Background="#F0F0F0">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Filters -->
        <Border Grid.Row="0"
                Background="#F7F7F7"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                CornerRadius="3"
                Padding="10,8"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="From:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <DatePicker x:Name="dtpFrom" Grid.Column="1" Width="130" Height="26" Margin="0,0,12,0"/>

                <TextBlock Grid.Column="2" Text="To:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <DatePicker x:Name="dtpTo" Grid.Column="3" Width="130" Height="26" Margin="0,0,12,0"/>

                <TextBlock Grid.Column="4" Text="User:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="cmbUser"
                          Grid.Column="5"
                          Width="150" Height="26" Margin="0,0,12,0"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="UserId"/>

                <TextBlock Grid.Column="6" Text="Status:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="cmbStatus" Grid.Column="7" Width="110" Height="26" Margin="0,0,12,0">
                    <ComboBoxItem Content="(All)" IsSelected="True"/>
                    <ComboBoxItem Content="Success"/>
                    <ComboBoxItem Content="Failed"/>
                    <ComboBoxItem Content="Running"/>
                </ComboBox>

                <StackPanel Grid.Column="9" Orientation="Horizontal">
                    <Button x:Name="btnApply" Content="Apply Filter"
                            Width="100" Height="26" Margin="0,0,6,0"
                            Click="btnApply_Click"/>
                    <Button x:Name="btnClear" Content="Clear"
                            Width="70" Height="26"
                            Click="btnClear_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Data grid -->
        <DataGrid x:Name="dgLogs"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  Background="White"
                  RowHeight="24"
                  BorderBrush="#A0A0A0" BorderThickness="1"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Run ID"      Binding="{Binding RunId}"           Width="70"/>
                <DataGridTextColumn Header="Started"     Binding="{Binding StartedAt, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="150"/>
                <DataGridTextColumn Header="Finished"    Binding="{Binding FinishedAt, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="150"/>
                <DataGridTextColumn Header="User"        Binding="{Binding UserId}"          Width="90"/>
                <DataGridTextColumn Header="Name"        Binding="{Binding DisplayName}"     Width="140"/>
                <DataGridTextColumn Header="Script"      Binding="{Binding ScriptName}"      Width="220"/>
                <DataGridTextColumn Header="Status"      Binding="{Binding Status}"          Width="80"/>
                <DataGridTextColumn Header="Rows"        Binding="{Binding RowsAffected}"    Width="70"/>
                <DataGridTextColumn Header="Error"       Binding="{Binding ErrorMessage}"    Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Bottom buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="lblRowCount" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#555"/>
            <Button x:Name="btnExportPdf" Content="Export to PDF"
                    Width="130" Height="32" Margin="0,0,8,0"
                    Click="btnExportPdf_Click"/>
            <Button x:Name="btnClose" Content="Close"
                    Width="90" Height="32"
                    Click="btnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>