<Window x:Class="KabarakScriptRunnerApp.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User Details"
        Height="380" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F0F0">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                   x:Name="lblHeader"
                   Text="User Details"
                   FontSize="15" FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,16"/>

        <!-- User ID -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="User ID" VerticalAlignment="Center"/>
        <TextBox x:Name="txtUserId" Grid.Row="1" Grid.Column="1" Height="24" Margin="0,0,0,8"/>

        <!-- Display Name -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Display Name" VerticalAlignment="Center"/>
        <TextBox x:Name="txtDisplayName" Grid.Row="2" Grid.Column="1" Height="24" Margin="0,0,0,8"/>

        <!-- Department -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Department" VerticalAlignment="Center"/>
        <ComboBox x:Name="cmbDepartment"
                  Grid.Row="3" Grid.Column="1"
                  Height="24" Margin="0,0,0,8"
                  DisplayMemberPath="DepartmentName"
                  SelectedValuePath="DepartmentId"/>

        <!-- Password (only visible for new users) -->
        <TextBlock x:Name="lblPassword" Grid.Row="4" Grid.Column="0"
                   Text="Password" VerticalAlignment="Center"/>
        <PasswordBox x:Name="txtPassword"
                     Grid.Row="4" Grid.Column="1"
                     Height="24" Margin="0,0,0,8"/>

        <!-- Confirm password (only for new users) -->
        <TextBlock x:Name="lblPasswordConfirm" Grid.Row="5" Grid.Column="0"
                   Text="Confirm Password" VerticalAlignment="Center"/>
        <PasswordBox x:Name="txtPasswordConfirm"
                     Grid.Row="5" Grid.Column="1"
                     Height="24" Margin="0,0,0,8"/>

        <!-- Admin flag -->
        <TextBlock Grid.Row="6" Grid.Column="0" Text="Is Admin" VerticalAlignment="Center"/>
        <CheckBox x:Name="chkIsAdmin" Grid.Row="6" Grid.Column="1"
                  Content="Grant admin privileges"
                  Margin="0,0,0,8"/>

        <!-- Error message -->
        <TextBlock x:Name="lblError"
                   Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                   Foreground="Red"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnSave" Content="Save"
                    Width="90" Height="32" Margin="0,0,8,0"
                    IsDefault="True"
                    Click="btnSave_Click"/>
            <Button x:Name="btnCancel" Content="Cancel"
                    Width="90" Height="32"
                    IsCancel="True"
                    Click="btnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>