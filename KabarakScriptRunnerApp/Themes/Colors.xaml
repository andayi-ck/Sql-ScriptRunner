<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Color.Primary">#1565C0</Color>
    <Color x:Key="Color.PrimaryDark">#0D47A1</Color>
    <Color x:Key="Color.PrimaryLight">#E3F2FD</Color>
    <Color x:Key="Color.Success">#2E7D32</Color>
    <Color x:Key="Color.Warning">#E65100</Color>
    <Color x:Key="Color.Danger">#C62828</Color>
    <Color x:Key="Color.Text">#1A2332</Color>
    <Color x:Key="Color.TextMuted">#5A6577</Color>
    <Color x:Key="Color.Border">#E3E8EF</Color>
    <Color x:Key="Color.Page">#F4F6F8</Color>

    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Primary}"/>
    <SolidColorBrush x:Key="Brush.PrimaryDark" Color="{StaticResource Color.PrimaryDark}"/>
    <SolidColorBrush x:Key="Brush.PrimaryLight" Color="{StaticResource Color.PrimaryLight}"/>
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}"/>
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}"/>
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}"/>
    <SolidColorBrush x:Key="Brush.Page" Color="{StaticResource Color.Page}"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="White"/>
    <SolidColorBrush x:Key="Brush.Hover" Color="#F5F9FC"/>
    <SolidColorBrush x:Key="Brush.Disabled" Color="#9EADC2"/>
</ResourceDictionary>
